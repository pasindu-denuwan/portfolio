<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="description"
    content="Portfolio of Pasindu Denuwan - Data & Technology Enthusiast & Undergraduate at Sabaragamuwa University of Sri Lanka. Discover projects, skills, education, experience, and certifications.">
  <title>Pasindu Denuwan | Portfolio</title>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <link rel="stylesheet" href="css/style.css">
</head>

<body>
  <canvas id="velaris-canvas"
    style="position: fixed; top: 0; left: 0; width: 100vw; height: 100vh; z-index: -1; pointer-events: none;"></canvas>

  <!-- Top Navigation -->
  <header class="top-nav" id="navbar">
    <div class="nav-container">
      <div class="nav-brand">
        <!-- Optional brand logo can go here, keeping it clean as per image -->
      </div>

      <nav class="nav-menu-wrapper">
        <ul id="nav-menu" class="nav-links">
          <li><a href="#home" class="nav-link active">Home</a></li>
          <li><a href="#about" class="nav-link">About</a></li>
          <li><a href="#services" class="nav-link">Services</a></li>
          <li><a href="#projects" class="nav-link">Projects</a></li>
          <li><a href="#contact" class="nav-link">Contact</a></li>
        </ul>
      </nav>

      <div class="nav-actions">
        <a href="#contact" class="btn btn-gradient btn-sm lets-talk-btn">Let's Talk</a>
        <button class="hamburger" id="hamburger" aria-label="Toggle Navigation Menu">
          <i class="fa-solid fa-bars" id="hamburger-icon"></i>
        </button>
      </div>
    </div>
  </header>

  <!-- Main Content -->
  <main class="main-content" id="main-content">

    <!-- Hero Section -->
    <section id="home" class="hero-section">
      <div class="hero-container">

        <div class="hero-text">
          <p class="greeting">HELLO, I'M</p>
          <h1 class="hero-title">
            <span id="hero-name-first" class="text-white">Pasindu</span>
            <span id="hero-name-last" class="highlight-purple">Denuwan</span>
          </h1>
          <h2 class="hero-subtitle text-white">Data Scientist | Software Developer</h2>
          <p class="hero-desc" id="hero-bio">Data Scientist & Software Developer passionate about turning data and ideas
            into meaningful digital solutions while continuously learning and exploring new technologies.</p>

          <div class="hero-actions">
            <a href="#projects" class="btn btn-gradient">View My Projects <i class="fa-solid fa-arrow-right"></i></a>
            <a href="resume.pdf" class="btn btn-outline" id="download-cv-btn" target="_blank" download>
              <i class="fa-solid fa-download"></i> Download CV
            </a>
          </div>
        </div>

        <div class="hero-visual">
          <div class="visual-glow-bg"></div>
          <div class="visual-circle-mask">
            <img src="assets/avatar.png" alt="Pasindu Denuwan Portrait" id="avatar-img"
              onerror="this.src='https://placehold.co/600x600/1A1A2E/8a2be2?text=Portrait'">
          </div>
          <div class="floating-badge">
            <span class="badge-number">5+</span>
            <span class="badge-text">Years of<br>Experience</span>
          </div>
        </div>

      </div>
    </section>

    <!-- Services Section -->
    <section id="services" class="services-section">
      <div class="container">
        <div class="section-header">
          <span class="section-tag">WHAT I DO</span>
          <h2>Services I Offer</h2>
        </div>
        <div class="services-grid" id="skills-container">
          <!-- Populated via JS -->
        </div>
      </div>
    </section>

    <!-- Projects Section -->
    <section id="portfolio" class="portfolio-section">
      <div class="container">
        <div class="portfolio-header">
          <div>
            <span class="section-tag">MY WORK</span>
            <h2>Featured Projects</h2>
          </div>
          <a href="#portfolio" class="btn btn-outline btn-view-all">View All Projects <i
              class="fa-solid fa-arrow-right"></i></a>
        </div>
        <div class="projects-grid" id="projects-container">
          <!-- Populated via JS -->
        </div>
      </div>
    </section>

    <!-- Stats Section -->
    <section class="stats-section">
      <div class="container">
        <div class="stats-container" id="about-stats">
          <!-- Populated via JS -->
        </div>
      </div>
    </section>

    <!-- Contact Section -->
    <section id="contact" class="contact-section">
      <div class="container">
        <div class="contact-grid">
          <div class="contact-promo">
            <div class="promo-icon"><i class="fa-regular fa-paper-plane"></i></div>
            <h3>Let's Work Together!</h3>
            <p>Have a project in mind?<br>Let's create something great.</p>
          </div>

          <div class="contact-form-wrapper">
            <form id="contact-form">
              <div class="form-row">
                <input type="text" id="form-name" placeholder="Your Name" required>
                <input type="email" id="form-email" placeholder="Your Email" required>
              </div>
              <textarea id="form-message" placeholder="Your Message" required></textarea>
              <button type="submit" class="btn btn-gradient">Send Message <i
                  class="fa-solid fa-paper-plane"></i></button>
            </form>
          </div>

          <div class="contact-info" id="contact-details">
            <!-- Populated via JS -->
          </div>
        </div>
      </div>
    </section>
  </main>

  <div class="modal-overlay" id="project-modal">
    <div class="modal-box">
      <button class="modal-close-btn" id="modal-close">&times;</button>
      <div id="modal-content"></div>
    </div>
  </div>

  <div class="toast-container" id="toast-container"></div>

  <script src="js/main.js"></script>
  <script src="js/velaris.js"></script>
</body>

</html>